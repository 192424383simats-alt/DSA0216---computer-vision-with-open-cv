      "source": [
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "path = \"/content/Picture1.jpg\"\n",
        "\n",
        "image = cv2.imread(path)\n",
        "\n",
        "if image is None:\n",
        "    print(\"Image not found\")\n",
        "else:\n",
        "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
        "    plt.imshow(gray, cmap='gray')\n",
        "    plt.axis('off')\n",
        "    plt.show()\n"
      ],
